# Copy this file to .env.local and fill in real values from your Supabase
# project settings (Project Settings -> API). See README.md's "Supabase
# Backend Setup" section for the full walkthrough.
#
# .env.local is gitignored — never commit real values.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# The "anon" / "public" API key — safe to expose in frontend code by
# design. It grants no access on its own; Row Level Security policies on
# each table decide what the anon role can actually read or write.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-side only — NEVER prefix this with VITE_, and never import it from
# anything under src/. Vite inlines every VITE_-prefixed variable into the
# browser bundle; this key must never end up there. It's only used by
# local one-off/admin scripts (e.g. scripts/verifySupabase.ts's optional
# authenticated check, or a future migration script) run directly with
# Node, not by the website itself.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
